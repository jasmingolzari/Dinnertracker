<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="no.gr2631.dinnertracker.ui.FridgePageController">
   <center>
      <VBox alignment="TOP_CENTER" prefHeight="89.0" prefWidth="600.0" spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <StackPane maxWidth="Infinity" prefHeight="48.0">
               <children>
                  <HBox alignment="CENTER" mouseTransparent="true" spacing="8.0">
                     <children>
                        <FontIcon iconColor="#2F6B3B" iconLiteral="mdi2f-fridge-outline" iconSize="24" />
                        <Label text="Kjøleskap" textAlignment="CENTER">
                           <font>
                              <Font name="System Bold" size="24.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <Button mnemonicParsing="false" onAction="#backToHomePage" style="-fx-background-color: #2F6B3B; -fx-text-fill: white;" text="Tilbake" StackPane.alignment="CENTER_LEFT">
                     <graphic>
                        <FontIcon iconColor="white" iconLiteral="mdi2a-arrow-left" iconSize="18" />
                     </graphic>
                  </Button>
               </children>
            </StackPane>
            <Label alignment="CENTER" maxWidth="Infinity" prefHeight="34.0" text="Her kan du legge til varer." textAlignment="CENTER" />
            <HBox alignment="CENTER" maxWidth="Infinity" prefHeight="48.0" spacing="12.0">
               <children>
                  <TextField fx:id="foodItemField" prefHeight="40.0" prefWidth="260.0" promptText="Vare" />
                  <Spinner fx:id="quantitySpinner" editable="true" prefHeight="40.0" prefWidth="80.0" />
                  <ComboBox fx:id="unitComboBox" prefHeight="40.0" prefWidth="70.0" promptText="Enhet" />
                  <Button fx:id="addFoodItemButton" mnemonicParsing="false" onAction="#addFoodItem" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #2F6B3B; -fx-font-weight: bold; -fx-text-fill: white;" text="Legg til matvare">
                     <graphic>
                        <FontIcon iconColor="white" iconLiteral="mdi2p-plus" iconSize="18" />
                     </graphic>
                  </Button>
               </children>
            </HBox>
            <TableView prefHeight="275.0" prefWidth="600.0">
              <columns>
                <TableColumn prefWidth="458.0" text="Matvarer" />
                <TableColumn minWidth="0.0" prefWidth="142.0" text="Antall" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
