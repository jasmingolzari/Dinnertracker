<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<VBox fx:id="recipesRoot" alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="40.0" />
   </padding>
   <children>
      <Label fx:id="recipesTitle" text="Oppskrifter">
         <font>
            <Font name="Arial Rounded MT Bold" size="32.0" />
         </font>
      </Label>
      <ListView fx:id="recipesList" prefHeight="350.0" prefWidth="500.0">
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
      </ListView>
      <Button fx:id="makeNewRecipeButton" mnemonicParsing="false" onAction="#makeNewRecipe" prefHeight="45.0" prefWidth="220.0" text="+ Lag ny oppskrift">
         <VBox.margin>
            <Insets top="15.0" />
         </VBox.margin>
      </Button>
   </children>
</VBox>
